rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // NOTE: contestants and config are writable by any signed-in user because the
    // admin PIN is only a client-side check. Harden with an admin custom claim before a wide launch.
    match /contestants/{id} { allow read, write: if request.auth != null; }
    match /config/{id} { allow read, write: if request.auth != null; }
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /leagues/{id} { allow read, create, update: if request.auth != null; }
  }
}
