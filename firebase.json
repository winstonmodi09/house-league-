{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "firestore.rules", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/admin", "destination": "/index.html" },
      { "source": "/admin/", "destination": "/index.html" }
    ],
    "headers": [
      { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "firestore": { "rules": "firestore.rules" }
}
